PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
MONGO_URI=mongodb+srv://YOUR_MONGODB_USER:YOUR_MONGODB_PASSWORD@YOUR_MONGODB_HOST/blockcad?retryWrites=true&w=majority

# PostgreSQL
POSTGRES_URI=postgresql://YOUR_NEON_USER:YOUR_NEON_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require&channel_binding=require

# Authentication (replace with a randomly generated secret of at least 32 characters)
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
